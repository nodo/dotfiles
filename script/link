#!/bin/bash
# Symlink dotfiles and config directories

source "$(dirname "$0")/lib.sh"
set -x

# Link dotfiles to home directory
files=(
	"ripgreprc"
	"gitconfig"
	"gitconfig-work"
	"tmux.conf"
	"zshrc"
)
for file in ${files[@]}; do
	ln -fs "$DOTFILES_DIR/config/${file}" "$HOME/.${file}"
done

# Link config directories
mkdir -p "$HOME/.config"
ln -fs "$DOTFILES_DIR/config/starship.toml" "$HOME/.config/starship.toml"

# Link Claude Code settings (Notification hook -> ntfy mobile push).
# NOTE: this replaces ~/.claude/settings.json with a symlink, so merge any
# existing settings into claude/settings.json first.
mkdir -p "$HOME/.claude"
ln -fs "$DOTFILES_DIR/claude/settings.json" "$HOME/.claude/settings.json"

# Remove existing directories/symlinks before linking to avoid nested symlinks
rm -rf "$HOME/.config/nvim"
ln -s "$DOTFILES_DIR/nvim" "$HOME/.config/nvim"

# Link terminal configs on macOS
if [[ "$OS" == "Darwin" ]]; then
  rm -rf "$HOME/.config/alacritty"
  ln -s "$DOTFILES_DIR/alacritty" "$HOME/.config/alacritty"
  rm -rf "$HOME/.config/ghostty"
  ln -s "$DOTFILES_DIR/ghostty" "$HOME/.config/ghostty"
fi
