[user]
    name = Andrea Nodari
    email = and.nodari@gmail.com
    signingkey = ~/.ssh/id_ed25519.pub
[alias]
    co = checkout
    st = status
    wt = worktree list
[init]
    defaultBranch = main
[pull]
    rebase = true
[gpg]
    format = ssh
[gpg "ssh"]
    allowedSignersFile = ~/.config/git/allowed_signers

[includeIf "gitdir:~/work/"]
    path = ~/.gitconfig-work
